# Next.js app only. Convex values (Better Auth, GitHub OAuth and App
# credentials) live in the Convex deployment: see docs/ENVIRONMENT.md.

# Generated by `bunx convex dev` for the standalone Convex project.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Must match DOWNLOAD_REDIRECT_SECRET in the Convex deployment.
DOWNLOAD_REDIRECT_SECRET=
# Must match AUTH_PROXY_SECRET in the Convex deployment (auth rate limiting).
AUTH_PROXY_SECRET=

# Optional: client address detection behind proxies (src/lib/client-address.ts).
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=cf-connecting-ip
